      "name": "Успешные ответы",
      "item": [
        {
          "name": "01 Афиша — 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "2"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Ожидаемый ответ: 2xx",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
